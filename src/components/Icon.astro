---
// Small line icons (24x24, stroke = currentColor). Decorative, so hidden from assistive tech.
interface Props {
  name: 'network' | 'pulse' | 'shield' | 'music' | 'clusters' | 'chart';
}
const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'network' && (<>
    <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
    <line x1="8.6" y1="13.5" x2="15.4" y2="17.5" /><line x1="15.4" y1="6.5" x2="8.6" y2="10.5" />
  </>)}
  {name === 'pulse' && <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />}
  {name === 'shield' && <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />}
  {name === 'music' && (<>
    <path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" />
  </>)}
  {name === 'clusters' && (<>
    <circle cx="7" cy="8" r="3" /><circle cx="17" cy="8" r="3" /><circle cx="12" cy="17" r="3" />
  </>)}
  {name === 'chart' && (<>
    <line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" />
  </>)}
</svg>
